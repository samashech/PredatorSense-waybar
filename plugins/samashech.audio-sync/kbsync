#!/usr/bin/python3
"""kbsync: Acer Predator 4-zone keyboard lighting: audio sync, typing ripple, notification flash.

  kbsync run            daemon: light the keyboard from the enabled layers and print
                        "f<TAB>level<TAB>#z1<TAB>#z2<TAB>#z3<TAB>#z4" ~25x/s.
                        Reads commands on stdin: "notify <0|1|2>" (urgency low/normal/critical)
  kbsync config         print the saved settings as key<TAB>value lines
  kbsync set KEY VALUE  change one setting (a running daemon picks it up live)
  kbsync restore        paint the idle color now
  kbsync probe          print device/keyboard availability
  kbsync keytest [GAP]  latency check: type and only the hit zone flashes; GAP is ms between writes

Needs the facer (acer-predator-turbo-and-rgb-keyboard) driver, which exposes
/dev/acer-gkbbl-0 (effect/brightness) and /dev/acer-gkbbl-static-0 (per zone).
Audio comes from `parec` on the default sink's monitor. Notification flash watches
Notify calls on the session bus for their urgency only, and skips them during
Do Not Disturb. Typing ripple reads key
presses from the built-in keyboard only to place a ripple; key codes are turned
into a position immediately and are never stored, printed, or sent anywhere.
"""
import cmath
import colorsys
import ctypes
import fcntl
import json
import math
import os
import select
import signal
import struct
import subprocess
import sys
import time

DYN_DEV = "/dev/acer-gkbbl-0"
STATIC_DEV = "/dev/acer-gkbbl-static-0"
KEYBOARD_NAME = "AT Translated Set 2 keyboard"   # the laptop's built-in keyboard
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "omarchy-audio-sync")
CONFIG = os.path.join(STATE_DIR, "config.json")
LOCK = os.path.join(STATE_DIR, "daemon.lock")

RATE = 16000          # Hz; plenty for 4 bands and cheap to FFT in pure Python
HOP = 320             # samples per analysis frame -> 50 frames/s
N = 512               # FFT window (32 ms)
TICK = 0.02           # render every 20 ms
ZONES = 4
ZONE_X = [0.125, 0.375, 0.625, 0.875]   # zone centers across the keyboard, 0..1
BANDS = [(35, 150), (150, 600), (600, 2400), (2400, 7800)]  # bass, low-mid, high-mid, treble

MODES = ("pulse", "spectrum", "wave", "theme")
IDLES = ("theme", "white", "off")
RIPPLES = ("theme", "rainbow", "white")
SOUNDS = ("blue", "brown", "typewriter")
BOOLS = ("enabled", "typing", "notify", "sounds")
DEFAULTS = {"enabled": False, "typing": False, "notify": False, "mode": "pulse",
            "sensitivity": 100, "brightness": 100, "idle": "theme", "ripple": "theme",
            "accent": "#7aa2f7", "sounds": False, "sound": "blue", "volume": 60}


# ---------------------------------------------------------------- settings
def valid_hex(v):
    return isinstance(v, str) and len(v) == 7 and v[0] == "#" and all(c in "0123456789abcdefABCDEF" for c in v[1:])


def clean(cfg):
    out = dict(DEFAULTS)
    if not isinstance(cfg, dict):
        return out
    for key in BOOLS:
        if isinstance(cfg.get(key), bool):
            out[key] = cfg[key]
    for key, allowed in (("mode", MODES), ("idle", IDLES), ("ripple", RIPPLES), ("sound", SOUNDS)):
        if cfg.get(key) in allowed:
            out[key] = cfg[key]
    for key, lo, hi in (("sensitivity", 25, 200), ("brightness", 10, 100), ("volume", 5, 100)):
        v = cfg.get(key)
        if isinstance(v, (int, float)) and not isinstance(v, bool):
            out[key] = int(max(lo, min(hi, round(v))))
    if valid_hex(cfg.get("accent")):
        out["accent"] = cfg["accent"].lower()
    return out


def load():
    try:
        with open(CONFIG) as f:
            if os.fstat(f.fileno()).st_size > 4096:
                return dict(DEFAULTS)
            return clean(json.load(f))
    except (OSError, ValueError):
        return dict(DEFAULTS)


def save(cfg):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = CONFIG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(clean(cfg), f, indent=2)
    os.replace(tmp, CONFIG)


def set_key(key, raw):
    cfg = load()
    if key in BOOLS:
        if raw not in ("true", "false"):
            sys.exit("kbsync: %s must be true or false" % key)
        cfg[key] = raw == "true"
    elif key in ("sensitivity", "brightness", "volume"):
        if not raw.isdigit() or len(raw) > 3:
            sys.exit("kbsync: %s must be a number" % key)
        cfg[key] = int(raw)
    elif (key == "mode" and raw in MODES) or (key == "idle" and raw in IDLES) or (key == "ripple" and raw in RIPPLES) or (key == "sound" and raw in SOUNDS):
        cfg[key] = raw
    elif key == "accent" and valid_hex(raw):
        cfg[key] = raw
    else:
        sys.exit("kbsync: invalid setting %s=%s" % (key, raw))
    save(cfg)


def hex_rgb(h):
    return (int(h[1:3], 16) / 255, int(h[3:5], 16) / 255, int(h[5:7], 16) / 255)


# ---------------------------------------------------------------- keyboard lights
class Keyboard:
    """Paces zone writes to the embedded controller.

    The WMI call returns in well under a millisecond, so the EC evidently takes
    the color and applies it on its own time; flooding it makes updates land
    late or not at all. So: only meaningful changes are sent, at most one write
    per GAP, the newest color per zone replaces an unsent older one, and a zone
    marked urgent (the one you just typed in) jumps the queue.
    """
    GAP = 0.003       # seconds between zone writes
    THRESH = 3        # ignore changes smaller than this (0-255 per channel)
    BIG = 32          # changes at least this large (hits, key presses) go out at once
    SETTLE = 0.04     # smaller changes (fades) reach a zone at most every 40 ms

    def __init__(self, gap=None):
        self.static = os.open(STATIC_DEV, os.O_WRONLY)
        self.dyn = os.open(DYN_DEV, os.O_WRONLY)
        self.gap = self.GAP if gap is None else gap
        self.last = [None] * ZONES     # what the EC was last sent
        self.want = [None] * ZONES     # what still needs sending
        self.urgent = None
        self.next_write = 0.0
        self.last_full = 0.0
        self.sent_at = [0.0] * ZONES

    def static_mode(self):
        # mode 0 (static), full hardware brightness; we dim in software instead.
        p = bytearray(16)
        p[2] = 100
        p[9] = 1
        os.write(self.dyn, bytes(p))

    def paint(self, colors, urgent=None, force=False):
        now = time.monotonic()
        if now - self.last_full > 1.0:  # re-send everything now and then in case the EC dropped one
            force, self.last_full = True, now
        for z, c in enumerate(colors):
            prev = self.last[z]
            d = 999 if prev is None else max(abs(a - b) for a, b in zip(c, prev))
            if force or d >= self.BIG or (d >= self.THRESH and now - self.sent_at[z] >= self.SETTLE):
                self.want[z] = c
            elif self.want[z] is not None and c == prev:
                self.want[z] = None   # went back to what the EC already shows
        if urgent is not None and self.want[urgent] is not None:
            self.urgent = urgent
        self.flush(now)

    def pending(self):
        return any(w is not None for w in self.want)

    def wait(self, now):
        """Seconds until the next queued write may go out, or None if nothing is queued."""
        return max(0.0, self.next_write - now) if self.pending() else None

    def _diff(self, z):
        prev = self.last[z]
        return 999 if prev is None else max(abs(a - b) for a, b in zip(self.want[z], prev))

    def flush(self, now=None):
        now = time.monotonic() if now is None else now
        while self.pending() and now >= self.next_write:
            if self.urgent is not None and self.want[self.urgent] is not None:
                z = self.urgent
            else:
                z = max((i for i in range(ZONES) if self.want[i] is not None), key=self._diff)
            self.urgent = None if z == self.urgent else self.urgent
            c = self.want[z]
            # Zones waiting for the same color go out together: the zone byte is a
            # bitmask, so a whole-keyboard flash is one EC write instead of four.
            same = [i for i in range(ZONES) if self.want[i] == c]
            mask = 0
            for i in same:
                mask |= 1 << i
            os.write(self.static, bytes((mask, c[0], c[1], c[2])))
            for i in same:
                self.last[i], self.want[i] = c, None
                self.sent_at[i] = now
            self.next_write = now + self.gap
            if self.gap > 0:
                break

    def flush_all(self):
        while self.pending():
            delay = self.wait(time.monotonic())
            if delay:
                time.sleep(delay)
            self.flush()


def idle_color(cfg):
    if cfg["idle"] == "off":
        return (0, 0, 0)
    if cfg["idle"] == "white":
        return (255, 255, 255)
    return tuple(int(round(c * 255)) for c in hex_rgb(cfg["accent"]))


def restore(cfg=None, kb=None):
    cfg = cfg or load()
    kb = kb or Keyboard()
    kb.static_mode()
    kb.paint([idle_color(cfg)] * ZONES, force=True)
    kb.flush_all()


# ---------------------------------------------------------------- key positions
def _key_x():
    """Linux key code -> horizontal position (0..1) on a 16" Predator layout with numpad."""
    x = {}
    def row(codes, start, step=1.0):
        for i, c in enumerate(codes):
            x[c] = start + i * step
    x[1] = 0.5                                   # Esc
    row(range(59, 69), 1.6, 1.1)                 # F1-F10
    x[87], x[88] = 12.6, 13.7                    # F11 F12
    x[110], x[111] = 14.8, 15.9                  # Insert Delete
    x[102], x[107], x[104], x[109] = 16.9, 17.9, 18.4, 18.9  # Home End PgUp PgDn
    x[41] = 0.5                                  # `
    row(range(2, 12), 1.5)                       # 1..0
    x[12], x[13], x[14] = 11.5, 12.5, 14.0       # - = Backspace
    x[15] = 0.75                                 # Tab
    row(range(16, 26), 2.0)                      # Q..P
    x[26], x[27], x[43] = 12.0, 13.0, 14.25      # [ ] \
    x[58] = 0.9                                  # Caps
    row(range(30, 39), 2.25)                     # A..L
    x[39], x[40], x[28] = 11.25, 12.25, 14.0     # ; ' Enter
    x[42] = 1.1                                  # LShift
    row(range(44, 51), 2.75)                     # Z..M
    x[51], x[52], x[53], x[54] = 9.75, 10.75, 11.75, 13.5  # , . / RShift
    x[29], x[125], x[56], x[57] = 0.6, 2.0, 3.1, 6.5  # LCtrl Super LAlt Space
    x[100], x[97], x[127] = 9.6, 10.8, 11.6      # RAlt RCtrl Menu
    x[105], x[103], x[108], x[106] = 12.6, 13.6, 13.6, 14.6  # arrows
    for c in (69, 71, 75, 79, 82):               # numpad left column
        x[c] = 15.75
    for c in (98, 72, 76, 80):
        x[c] = 16.75
    for c in (55, 73, 77, 81, 83):
        x[c] = 17.75
    for c in (74, 78, 96):
        x[c] = 18.75
    return {c: v / 19.5 for c, v in x.items()}


KEY_X = _key_x()


def zone_of(x):
    return max(0, min(ZONES - 1, int(x * ZONES)))
EVENT = struct.Struct("llHHi")   # struct input_event on 64-bit
EV_KEY = 1


def find_keyboard():
    try:
        with open("/proc/bus/input/devices") as f:
            blocks = f.read(1 << 20).split("\n\n")
    except OSError:
        return None
    for b in blocks:
        if 'N: Name="%s"' % KEYBOARD_NAME not in b:
            continue
        for line in b.splitlines():
            if line.startswith("H: Handlers="):
                for h in line.split("=", 1)[1].split():
                    if h.startswith("event") and h[5:].isdigit():
                        return "/dev/input/" + h
    return None


def open_keyboard():
    path = find_keyboard()
    if not path:
        return None
    try:
        return os.open(path, os.O_RDONLY | os.O_NONBLOCK)  # read only, never grabbed
    except OSError:
        return None


# ---------------------------------------------------------------- audio analysis
def make_fft(n):
    bits = n.bit_length() - 1
    rev = [int(format(i, "0%db" % bits)[::-1], 2) for i in range(n)]
    tw = [cmath.exp(-2j * math.pi * k / n) for k in range(n // 2)]

    def fft(x):
        a = [x[r] for r in rev]
        size = 2
        while size <= n:
            half, step = size // 2, n // size
            for start in range(0, n, size):
                k = 0
                for j in range(start, start + half):
                    t = tw[k] * a[j + half]
                    a[j + half] = a[j] - t
                    a[j] += t
                    k += step
            size *= 2
        return a
    return fft


class Analyzer:
    """Band levels with auto-gain plus a bass onset detector for the punch."""

    def __init__(self):
        self.fft = make_fft(N)
        self.win = [0.5 - 0.5 * math.cos(2 * math.pi * i / (N - 1)) for i in range(N)]
        self.buf = [0.0] * N
        hz = RATE / N
        self.bins = [(max(1, int(lo / hz)), max(int(lo / hz) + 1, int(math.ceil(hi / hz)))) for lo, hi in BANDS]
        self.peak = [1e-3] * len(BANDS)
        self.floor = [1e-3] * len(BANDS)
        self.smooth = [0.0] * len(BANDS)
        self.prev_db = [0.0] * len(BANDS)
        self.flux_hist = [0.0] * 50   # one second of bass flux
        self.since_beat = 99

    def frame(self, samples, sens):
        self.buf = self.buf[HOP:] + samples
        spec = self.fft([s * w for s, w in zip(self.buf, self.win)])
        rms = math.sqrt(sum(s * s for s in samples) / len(samples))
        levels, onsets = [], []
        for i, (lo, hi) in enumerate(self.bins):
            e = sum(abs(spec[k]) for k in range(lo, hi)) / (hi - lo)
            db = 20 * math.log10(e + 1e-6)
            # auto-gain: peak falls ~6 dB/s, floor rises slowly toward the quiet parts
            self.peak[i] = max(db, self.peak[i] - 0.12)
            self.floor[i] = min(db, self.floor[i] + 0.04)
            span = max(18.0, self.peak[i] - self.floor[i])
            lvl = max(0.0, min(1.0, (db - (self.peak[i] - span)) / span))
            onsets.append(max(0.0, db - self.prev_db[i]))
            self.prev_db[i] = 0.6 * self.prev_db[i] + 0.4 * db
            s = self.smooth[i]   # fast attack, quick release
            self.smooth[i] = lvl if lvl > s else s * 0.82 + lvl * 0.18
            levels.append(self.smooth[i])

        # bass/low-mid onset vs. its own recent history => beat
        flux = onsets[0] + 0.5 * onsets[1]
        hist = self.flux_hist
        hist.pop(0)
        hist.append(flux)
        mean = sum(hist) / len(hist)
        std = math.sqrt(sum((h - mean) ** 2 for h in hist) / len(hist))
        k = 1.6 * 100.0 / sens
        self.since_beat += 1
        silent = rms < 40  # int16 units; below this it's silence or hiss
        beat = (not silent and flux > mean + k * std and flux > 2.5 * 100.0 / sens
                and self.since_beat >= 6)  # max ~8 beats/s
        if beat:
            self.since_beat = 0
        if silent:
            levels = [0.0] * len(levels)
        return levels, beat, silent


# ---------------------------------------------------------------- layers
def hsv(h, v, s=1.0):
    return colorsys.hsv_to_rgb(h % 1.0, s, max(0.0, min(1.0, v)))


def mix(a, b, t):
    t = max(0.0, min(1.0, t))
    return tuple(x * (1 - t) + y * t for x, y in zip(a, b))


def to_bytes(rgb, bright):
    # perceptual curve: low levels stay dark so the hits pop
    return tuple(int(round(255 * (max(0.0, min(1.0, c)) ** 2.2) * bright)) for c in rgb)


def linear_idle(cfg):
    # idle color in the pre-curve space, so it comes out at its true value
    return tuple((c / 255) ** (1 / 2.2) for c in idle_color(cfg))


class AudioLayer:
    def __init__(self):
        self.hue = 0.0
        self.env = [0.0] * ZONES
        self.wave = []
        self.idle_mix = 1.0
        self.levels = [0.0] * 4
        self.beat = False
        self.silent = True

    def feed(self, levels, beat, silent):
        self.levels, self.silent = levels, silent
        self.beat = self.beat or beat   # latched until the next render

    def render(self, cfg):
        mode = cfg["mode"]
        levels, beat = self.levels, self.beat
        self.beat = False
        bass, lowmid, highmid, treble = levels
        overall = max(bass, 0.7 * lowmid, 0.5 * highmid)
        self.hue += 0.0015 + 0.004 * treble
        if beat:
            self.hue += 0.11
        decay = 0.80  # ~100 ms half-life: sharp hit, fast fall

        if mode == "wave":
            if beat:
                self.wave.append(0.0)
            self.env = [e * decay for e in self.env]
            alive = []
            for pos in self.wave:
                for z in range(ZONES):
                    d = abs(z - pos)
                    if d < 1.0:
                        self.env[z] = max(self.env[z], 1.0 - d)
                pos += 0.28
                if pos < ZONES + 1:
                    alive.append(pos)
            self.wave = alive
        else:
            hit = 1.0 if beat else 0.0
            self.env = [max(e * decay, hit) for e in self.env]

        out = []
        for z in range(ZONES):
            if mode == "spectrum":
                v = max(levels[z] ** 1.4, 0.9 * self.env[z] * bass if z < 2 else 0.0)
                rgb = hsv(z * 0.2 + 0.05 * math.sin(self.hue * 2), 0.12 + 0.88 * v)
            elif mode == "wave":
                v = max(self.env[z], 0.35 * overall)
                rgb = hsv(self.hue + z * 0.06, 0.08 + 0.92 * v)
            elif mode == "theme":
                v = max(self.env[z], 0.55 * overall)
                white = 0.35 * self.env[z] ** 2  # flash toward white on hard hits
                rgb = tuple(min(1.0, (c * (1 - white) + white) * (0.1 + 0.9 * v)) for c in hex_rgb(cfg["accent"]))
            else:  # pulse
                v = max(self.env[z], 0.5 * overall)
                rgb = hsv(self.hue + z * 0.035, 0.1 + 0.9 * v, s=1.0 - 0.25 * self.env[z] ** 3)
            out.append(rgb)

        # ease to the idle color during silence, snap back on sound
        target = 1.0 if self.silent else 0.0
        self.idle_mix += (target - self.idle_mix) * (0.03 if self.silent else 0.5)
        if self.idle_mix > 0.01:
            ic = linear_idle(cfg)
            out = [mix(rgb, ic, self.idle_mix) for rgb in out]
        return out, max([self.env[0]] + levels)


class RippleLayer:
    """Each key press lights its zone at once and spreads outward to the others."""
    SPEED = 12.0     # keyboard widths per second: ~20 ms (one frame) per zone
    HOLD = 0.05      # seconds each zone stays at full strength when the front reaches it
    FADE = 0.16      # then seconds to fall to ~37%
    REACH = 3.0      # how fast the ripple weakens with distance

    def __init__(self):
        self.ripples = []   # (x, t0, rgb)
        self.hue = 0.0

    def press(self, x, cfg, now):
        if cfg["ripple"] == "rainbow":
            self.hue += 0.083
            rgb = hsv(self.hue, 1.0)
        elif cfg["ripple"] == "white":
            rgb = (1.0, 1.0, 1.0)
        else:
            rgb = hex_rgb(cfg["accent"])
            # lift the accent so it reads as a hit even when it is dark
            m = max(rgb) or 1.0
            rgb = tuple(c / m for c in rgb)
        self.ripples.append((x, now, rgb))
        if len(self.ripples) > 24:
            self.ripples.pop(0)

    def apply(self, base, now):
        if not self.ripples:
            return base, 0.0
        out = list(base)
        peak = 0.0
        alive = []
        for x, t0, rgb in self.ripples:
            age = now - t0
            if age > 1.2:
                continue
            alive.append((x, t0, rgb))
            for z in range(ZONES):
                # distance to the zone's nearest edge: 0 for the zone the key is in
                d = max(0.0, z / ZONES - x, x - (z + 1) / ZONES)
                a = age - d / self.SPEED
                if a < 0:
                    continue
                env = 1.0 if a < self.HOLD else math.exp(-(a - self.HOLD) / self.FADE)
                amp = math.exp(-d * self.REACH) * env
                if amp > 0.01:
                    out[z] = mix(out[z], rgb, amp)
                    peak = max(peak, amp)
        self.ripples = alive
        return out, peak


class FlashLayer:
    """Notification flash: blinks over everything, then fades."""
    PATTERNS = {   # (blinks, color key, strength)
        0: (1, "accent", 0.6),
        1: (2, "accent", 1.0),
        2: (3, "red", 1.0),
    }

    def __init__(self):
        self.start = None
        self.urgency = 1

    def trigger(self, urgency, now):
        self.start, self.urgency = now, urgency

    def apply(self, base, cfg, now):
        if self.start is None:
            return base, 0.0
        blinks, color, strength = self.PATTERNS[self.urgency]
        t = now - self.start
        on, off, tail = 0.14, 0.11, 0.35   # long enough for the EC to show every blink
        last_on = blinks * (on + off) - off   # the final blink fades out instead of cutting
        if t < last_on:
            amp = 1.0 if (t % (on + off)) < on else 0.0
        elif t < last_on + tail:
            amp = (1.0 - (t - last_on) / tail) ** 2
        else:
            self.start = None
            return base, 0.0
        rgb = (1.0, 0.05, 0.02) if color == "red" else hex_rgb(cfg["accent"])
        m = max(rgb) or 1.0
        rgb = tuple(c / m for c in rgb)
        amp *= strength
        return [mix(c, rgb, amp) for c in base], amp


def die_with_parent():
    """Run in each child before exec: exit when the daemon does, however it ends."""
    try:
        ctypes.CDLL("libc.so.6").prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    except OSError:
        pass


# ---------------------------------------------------------------- notifications
class NotifyWatcher:
    """Watches org.freedesktop.Notifications.Notify calls on the session bus.

    Only two things are taken from each call: its urgency hint and whether it
    replaces an earlier notification. Titles and bodies are skipped unread.
    """
    MATCH = "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"

    def __init__(self):
        self.proc = subprocess.Popen(["dbus-monitor", "--session", self.MATCH],
                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, preexec_fn=die_with_parent)
        os.set_blocking(self.proc.stdout.fileno(), False)
        self.buf = b""
        self.msg = None           # {"urgency", "replaces", "args", "t"} for the call being read
        self.want_urgency = False

    def fileno(self):
        return self.proc.stdout.fileno()

    def close(self):
        self.proc.terminate()

    def _finish(self, out):
        if self.msg is not None:
            out.append((self.msg["urgency"], self.msg["replaces"]))
            self.msg = None

    def read(self, now):
        """Returns a list of (urgency, replaces) for completed Notify calls."""
        out = []
        try:
            chunk = os.read(self.fileno(), 65536)
        except BlockingIOError:
            chunk = b""
        if chunk == b"" and self.proc.poll() is not None:
            raise EOFError
        self.buf = (self.buf + chunk)[-262144:]
        *lines, self.buf = self.buf.split(b"\n")
        for raw in lines:
            line = raw.decode("utf-8", "replace")
            if line.startswith(("method call", "signal", "method return", "error")):
                self._finish(out)
                if line.startswith("method call") and "member=Notify" in line:
                    self.msg = {"urgency": 1, "replaces": False, "uints": 0, "t": now}
                continue
            if self.msg is None:
                continue
            s = line.strip()
            # Notify(app_name s, replaces_id u, ...): the first uint32 is replaces_id
            if s.startswith("uint32 ") and self.msg["uints"] == 0:
                self.msg["uints"] = 1
                self.msg["replaces"] = s[7:].strip() not in ("", "0")
            elif s == 'string "urgency"':
                self.want_urgency = True
            elif self.want_urgency:
                self.want_urgency = False
                if s.startswith("variant") and s.split()[-1] in ("0", "1", "2"):
                    self.msg["urgency"] = int(s.split()[-1])
        return out

    def flush(self, now):
        """A call is complete once dbus-monitor goes quiet after it."""
        out = []
        if self.msg is not None and now - self.msg["t"] > 0.05:
            self._finish(out)
        return out


def dnd_on():
    try:
        r = subprocess.run(["omarchy-shell", "notifications", "isDnd"], capture_output=True, text=True, timeout=1)
        return r.stdout.strip() == "on"
    except (OSError, subprocess.SubprocessError):
        return False


# ---------------------------------------------------------------- daemon
def default_sink():
    try:
        return subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True, timeout=2).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def start_capture(sink):
    dev = (sink + ".monitor") if sink else "@DEFAULT_MONITOR@"
    return subprocess.Popen(
        ["parec", "-d", dev, "--raw", "--format=s16le", "--rate=%d" % RATE, "--channels=1", "--latency-msec=15"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, preexec_fn=die_with_parent)


def run():
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit("kbsync: already running")
    try:  # die with the shell
        ctypes.CDLL("libc.so.6").prctl(1, signal.SIGTERM)
    except OSError:
        pass

    kb = Keyboard()
    cfg = load()
    stop = []
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda *_: stop.append(1))
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)

    cap, sink, pending = None, "", b""
    keys = None
    watcher, last_flash = None, -10.0
    stdin_fd = sys.stdin.fileno()
    os.set_blocking(stdin_fd, False)
    stdin_buf, stdin_open = b"", True

    an = Analyzer()
    audio, ripple, flash = AudioLayer(), RippleLayer(), FlashLayer()
    kb.static_mode()
    need = HOP * 2
    frame_no = 0
    cfg_mtime, last_check, last_sink_check = -1.0, 0.0, 0.0
    next_tick = time.monotonic()
    reported = None
    urgent = None
    try:
        while not stop:
            now = time.monotonic()
            if now - last_check > 0.5:
                last_check = now
                try:
                    m = os.stat(CONFIG).st_mtime
                except OSError:
                    m = 0.0
                if m != cfg_mtime:
                    cfg_mtime, cfg = m, load()
                # audio capture only while audio sync is on
                if cfg["enabled"]:
                    if cap is None or cap.poll() is not None:
                        sink, pending = default_sink(), b""
                        cap = start_capture(sink)
                        last_sink_check = now
                    elif now - last_sink_check > 4:  # follow headphones <-> speakers
                        last_sink_check = now
                        s = default_sink()
                        if s and s != sink:
                            cap.terminate()
                            sink, pending = s, b""
                            cap = start_capture(sink)
                elif cap is not None:
                    cap.terminate()
                    cap = None
                # keyboard input only while typing ripple is on
                if cfg["typing"] and keys is None:
                    keys = open_keyboard()
                elif not cfg["typing"] and keys is not None:
                    os.close(keys)
                    keys = None
                # notification watcher only while notification flash is on
                if cfg["notify"] and watcher is None:
                    try:
                        watcher = NotifyWatcher()
                    except OSError:
                        watcher = None
                elif not cfg["notify"] and watcher is not None:
                    watcher.close()
                    watcher = None
                status = "ok" if (not cfg["typing"] or keys is not None) else "noaccess"
                if status != reported:
                    reported = status
                    sys.stdout.write("s\ttyping\t%s\n" % status)
                    sys.stdout.flush()

            fds = [cap.stdout] if cap is not None else []
            if keys is not None:
                fds.append(keys)
            if watcher is not None:
                fds.append(watcher)
            if stdin_open:
                fds.append(stdin_fd)
            now = time.monotonic()
            timeout = max(0.0, next_tick - now)
            w = kb.wait(now)
            if w is not None:
                timeout = min(timeout, w)
            r, _, _ = select.select(fds, [], [], timeout)
            now = time.monotonic()
            kb.flush(now)   # paced writes still queued from the last frame

            if cap is not None and cap.stdout in r:
                chunk = os.read(cap.stdout.fileno(), 4096)
                if not chunk:
                    cap.wait()
                    cap = None
                else:
                    pending += chunk
                    while len(pending) >= need:
                        data, pending = pending[:need], pending[need:]
                        samples = [int.from_bytes(data[i:i + 2], "little", signed=True) for i in range(0, need, 2)]
                        audio.feed(*an.frame(samples, cfg["sensitivity"]))

            if keys is not None and keys in r:
                try:
                    data = os.read(keys, EVENT.size * 64)
                except BlockingIOError:
                    data = b""
                except OSError:  # keyboard went away (suspend/resume); reopen later
                    os.close(keys)
                    keys, data = None, b""
                for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
                    _, _, etype, code, value = EVENT.unpack_from(data, off)
                    if etype == EV_KEY and value == 1:
                        x = KEY_X.get(code, 0.5)
                        ripple.press(x, cfg, now)
                        urgent = zone_of(x)
                        next_tick = now   # draw the press now, not at the next frame

            if watcher is not None:
                try:
                    events = watcher.read(now) if watcher in r else []
                    events += watcher.flush(now)
                except EOFError:  # dbus-monitor died; the config check starts a new one
                    watcher, events = None, []
                for urgency, replaces in events:
                    # updates to an existing card (progress bars, track changes) don't flash,
                    # nor does a burst, nor anything during Do Not Disturb
                    if replaces or now - last_flash < 1.0 or dnd_on():
                        continue
                    last_flash = now
                    flash.trigger(urgency, now)

            if stdin_open and stdin_fd in r:
                try:
                    chunk = os.read(stdin_fd, 1024)
                except BlockingIOError:
                    chunk = b"-"
                if not chunk:
                    stdin_open = False
                else:
                    stdin_buf = (stdin_buf + chunk)[-1024:]
                    *lines, stdin_buf = stdin_buf.split(b"\n")
                    for line in lines:
                        p = line.decode("ascii", "replace").split()
                        if len(p) == 2 and p[0] == "notify" and p[1] in ("0", "1", "2") and cfg["notify"]:
                            flash.trigger(int(p[1]), now)

            if now < next_tick:
                continue
            next_tick = next_tick + TICK if now - next_tick < 0.1 else now + TICK

            # base: audio sync, or the idle color when audio is off
            if cfg["enabled"]:
                rgb, lvl = audio.render(cfg)
            else:
                rgb, lvl = [linear_idle(cfg)] * ZONES, 0.0
            rgb, rp = ripple.apply(rgb, now)
            rgb, fp = flash.apply(rgb, cfg, now)
            colors = [to_bytes(c, cfg["brightness"] / 100) for c in rgb]
            kb.paint(colors, urgent=urgent)
            urgent = None

            frame_no += 1
            if frame_no % 2 == 0:  # 25 Hz to the bar widget
                level = int(100 * min(1.0, max(lvl, rp, fp)))
                sys.stdout.write("f\t%d\t%s\n" % (level, "\t".join("#%02x%02x%02x" % c for c in colors)))
                sys.stdout.flush()
    finally:
        if cap is not None:
            cap.terminate()
        if watcher is not None:
            watcher.close()
        try:
            restore(load(), kb)
        except OSError:
            pass


def keytest(gap_ms):
    """Raw latency check: each press flashes only its zone white; nothing else writes."""
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit("kbsync: Keyboard Sync is running. Turn its switches off in the panel first.")
    keys = open_keyboard()
    if keys is None:
        sys.exit("kbsync: can't read the built-in keyboard (needs the input group)")
    kb = Keyboard(gap=gap_ms / 1000.0)
    kb.static_mode()
    kb.paint([(0, 0, 0)] * ZONES, force=True)
    kb.flush_all()
    print("Keyboard is dark. Type anywhere: the zone you hit flashes white.")
    print("Write gap %.1f ms. Ctrl+C to stop.\n" % gap_ms)
    off_at = [0.0] * ZONES
    colors = [(0, 0, 0)] * ZONES
    try:
        while True:
            now = time.monotonic()
            w = kb.wait(now)
            r, _, _ = select.select([keys], [], [], 0.01 if w is None else min(0.01, w))
            now = time.monotonic()
            kb.flush(now)
            hit, stamps = None, []
            if r:
                try:
                    data = os.read(keys, EVENT.size * 64)
                except BlockingIOError:
                    data = b""
                for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
                    sec, usec, etype, code, value = EVENT.unpack_from(data, off)
                    if etype == EV_KEY and value == 1:
                        hit = zone_of(KEY_X.get(code, 0.5))
                        stamps.append(sec + usec / 1e6)
                        off_at[hit] = now + 0.15
                        colors[hit] = (255, 255, 255)
            changed = hit is not None
            for z in range(ZONES):
                if colors[z] != (0, 0, 0) and now >= off_at[z]:
                    colors[z], changed = (0, 0, 0), True
            if changed:
                kb.paint(list(colors), urgent=hit)
            if hit is not None:
                delay = (time.time() - stamps[-1]) * 1000
                print("zone %d   key to write: %.1f ms" % (hit + 1, delay), flush=True)
    except KeyboardInterrupt:
        pass
    finally:
        os.close(keys)
        restore(load(), kb)


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd == "run":
        run()
    elif cmd == "config":
        for k, v in load().items():
            print("%s\t%s" % (k, str(v).lower() if isinstance(v, bool) else v))
    elif cmd == "set" and len(args) == 3:
        set_key(args[1], args[2])
    elif cmd == "restore":
        restore()
    elif cmd == "keytest":
        gap = args[1] if len(args) > 1 else "3"
        if not gap.replace(".", "", 1).isdigit() or float(gap) > 100:
            sys.exit("kbsync: keytest [gap-ms 0-100]")
        keytest(float(gap))
    elif cmd == "probe":
        ok = os.access(STATIC_DEV, os.W_OK) and os.access(DYN_DEV, os.W_OK)
        print("device\t%s" % ("ok" if ok else "missing"))
        kp = find_keyboard()
        print("keyboard\t%s" % ("ok" if kp and os.access(kp, os.R_OK) else "noaccess"))
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
